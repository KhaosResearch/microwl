  <rdf:Description rdf:about="http://www.khaos.uma.es/microwl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">
            MICROWL - A Platform-Agnostic Ontology for Microservices Deployment
            
            DESIGN PRINCIPLES:
            1. Abstract layer with platform-agnostic concepts (WorkloadSpecification, 
               ContainerSpecification, NetworkSpecification, StorageSpecification)
            2. Platform-specific layer (PlatformSpecificConfiguration) with resources
            3. Generic properties for cross-platform queries
            4. Extensible for new platforms without modifying existing structure
            
            Namespaces:
            - MICROWL: http://www.khaos.uma.es/microwl/
            - OMSAC: http://www.semanticweb.org/ontologyOfMicroservicesArchitecture
        </rdfs:comment>
    <dcterms:title xml:lang="en">MicrOWL: an ontology for the multi-platform validation of microservice deployments</dcterms:title>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
  </rdf:Description>
