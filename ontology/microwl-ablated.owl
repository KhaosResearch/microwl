        <microwl:resourceOf rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_DockerConfig"/>
        <microwl:resourceType>composeVersion</microwl:resourceType>
        <microwl:resourceValue>3.8</microwl:resourceValue>
    </owl:NamedIndividual>
    


    <!-- http://www.khaos.uma.es/microwl/DataAggregator_DockerVolume -->

