        <microwl:deployedOn rdf:resource="http://www.khaos.uma.es/microwl/DockerComposePlatform"/>
        <microwl:hasResource rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_DockerVersion"/>
        <microwl:hasResource rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_DockerVolume"/>
        <microwl:platformConfigOf rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator"/>
    </owl:NamedIndividual>
    


    <!-- http://www.khaos.uma.es/microwl/DataAggregator_DockerVersion -->

