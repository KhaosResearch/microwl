<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.khaos.uma.es/microwl#"
     xml:base="http://www.khaos.uma.es/microwl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:omsac="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:microwl="http://www.khaos.uma.es/microwl/">
    <owl:Ontology rdf:about="http://www.khaos.uma.es/microwl">
        <rdfs:comment xml:lang="en">
            MICROWL - A Platform-Agnostic Ontology for Microservices Deployment
            
            DESIGN PRINCIPLES:
            1. Abstract layer with platform-agnostic concepts (WorkloadSpecification, 
               ContainerSpecification, NetworkSpecification, StorageSpecification)
            2. Platform-specific layer (PlatformSpecificConfiguration) with resources
            3. Generic properties for cross-platform queries
            4. Extensible for new platforms without modifying existing structure
            
            Namespaces:
            - MICROWL: http://www.khaos.uma.es/microwl/
            - OMSAC: http://www.semanticweb.org/ontologyOfMicroservicesArchitecture
        </rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.khaos.uma.es/microwl#definedBySource -->

    <owl:AnnotationProperty rdf:about="http://www.khaos.uma.es/microwl#definedBySource"/>
    


    <!-- http://www.khaos.uma.es/microwl#hasDescription -->

    <owl:AnnotationProperty rdf:about="http://www.khaos.uma.es/microwl#hasDescription"/>
    


    <!-- http://www.khaos.uma.es/microwl#hasLabel -->

    <owl:AnnotationProperty rdf:about="http://www.khaos.uma.es/microwl#hasLabel"/>
    


    <!-- http://www.khaos.uma.es/microwl#resourceValue -->

    <owl:AnnotationProperty rdf:about="http://www.khaos.uma.es/microwl#resourceValue"/>
    


    <!-- http://www.khaos.uma.es/microwl/hasDescription -->

    <owl:AnnotationProperty rdf:about="http://www.khaos.uma.es/microwl/hasDescription"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.khaos.uma.es/microwl/antiPatternOf -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/antiPatternOf">
        <owl:inverseOf rdf:resource="http://www.khaos.uma.es/microwl/hasAntiPattern"/>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/configurationFor -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/configurationFor">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/DeploymentConfiguration"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/CloudProvider"/>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/containerSpecOf -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/containerSpecOf">
        <owl:inverseOf rdf:resource="http://www.khaos.uma.es/microwl/hasContainerSpec"/>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/deployedOn -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/deployedOn">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/PlatformSpecificConfiguration"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/DeploymentPlatform"/>
        <rdfs:comment xml:lang="en">Platform where this configuration is deployed</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/deployedOnInfrastructure -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/deployedOnInfrastructure">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/PlatformSpecificConfiguration"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/InfrastructureTarget"/>
        <rdfs:comment xml:lang="en">Concrete infrastructure (cluster) where this configuration is deployed</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/deployedTo -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/deployedTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/DeploymentPlatform"/>
        <rdfs:comment xml:lang="en">Platform(s) where the microservice is deployed</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/followsPattern -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/followsPattern">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/PlatformSpecificConfiguration"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/DeploymentPattern"/>
        <rdfs:comment xml:lang="en">Configuration follows a specific deployment pattern</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasAntiPattern -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/hasAntiPattern">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/AntiPattern"/>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasContainerSpec -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/hasContainerSpec">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/ContainerSpecification"/>
        <rdfs:comment xml:lang="en">Links a microservice to its container specification</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasEnvironmentVariable -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/hasEnvironmentVariable">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/ContainerSpecification"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/EnvironmentVariable"/>
        <rdfs:comment xml:lang="en">Container has environment variable</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasNetworkSpec -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/hasNetworkSpec">
        <owl:inverseOf rdf:resource="http://www.khaos.uma.es/microwl/networkSpecOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/NetworkSpecification"/>
        <rdfs:comment xml:lang="en">Links a microservice to its network specification</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasPlatformConfig -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/hasPlatformConfig">
        <owl:inverseOf rdf:resource="http://www.khaos.uma.es/microwl/platformConfigOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/PlatformSpecificConfiguration"/>
        <rdfs:comment xml:lang="en">Generic link to platform-specific configuration</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasQualityMetric -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/hasQualityMetric">
        <owl:inverseOf rdf:resource="http://www.khaos.uma.es/microwl/qualityMetricOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/QualityMetric"/>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasResource -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/hasResource">
        <owl:inverseOf rdf:resource="http://www.khaos.uma.es/microwl/resourceOf"/>
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/PlatformSpecificConfiguration"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/PlatformResource"/>
        <rdfs:comment xml:lang="en">Generic link to platform-specific resources (volumes, networks, ingresses, services)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasStorageSpec -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/hasStorageSpec">
        <owl:inverseOf rdf:resource="http://www.khaos.uma.es/microwl/storageSpecOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/StorageSpecification"/>
        <rdfs:comment xml:lang="en">Links a microservice to its storage specification</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasWorkloadSpec -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/hasWorkloadSpec">
        <owl:inverseOf rdf:resource="http://www.khaos.uma.es/microwl/workloadSpecOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/WorkloadSpecification"/>
        <rdfs:comment xml:lang="en">Links a microservice to its workload specification</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/implements -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/implements">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/AbstractConcept"/>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/networkSpecOf -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/networkSpecOf"/>
    


    <!-- http://www.khaos.uma.es/microwl/platformConfigOf -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/platformConfigOf"/>
    


    <!-- http://www.khaos.uma.es/microwl/providedBy -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/providedBy">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/ComputeService"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/CloudProvider"/>
        <rdfs:comment xml:lang="en">Which cloud provider offers this service</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/qualityMetricOf -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/qualityMetricOf"/>
    


    <!-- http://www.khaos.uma.es/microwl/resourceOf -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/resourceOf"/>
    


    <!-- http://www.khaos.uma.es/microwl/storageSpecOf -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/storageSpecOf"/>
    


    <!-- http://www.khaos.uma.es/microwl/throws -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/throws">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/DeploymentConfiguration"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/microwl/DeploymentError"/>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/utilisePattern -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/utilisePattern">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/DeploymentPattern"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Pattern"/>
    </owl:ObjectProperty>
    


    <!-- http://www.khaos.uma.es/microwl/workloadSpecOf -->

    <owl:ObjectProperty rdf:about="http://www.khaos.uma.es/microwl/workloadSpecOf"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.khaos.uma.es/microwl/hasAccessMode -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/hasAccessMode">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/StorageSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Storage access mode (ReadWriteOnce, ReadWriteMany) - platform-agnostic</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasCohesionScore -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/hasCohesionScore">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Cohesion score (0-1)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasContainerImage -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/hasContainerImage">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/ContainerSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Container image name (platform-agnostic)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasContainerPort -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/hasContainerPort">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/ContainerSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Port the container listens on (platform-agnostic)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasCouplingScore -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/hasCouplingScore">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Coupling score (0-1, lower is better)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasEnvKey -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/hasEnvKey">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/EnvironmentVariable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Environment variable key</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasEnvValue -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/hasEnvValue">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/EnvironmentVariable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Environment variable value</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasExposedPort -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/hasExposedPort">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/NetworkSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Port exposed externally (platform-agnostic)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasReplicas -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/hasReplicas">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/WorkloadSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of replicas (platform-agnostic)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/hasStorageSize -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/hasStorageSize">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/StorageSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Storage size (e.g., &apos;10Gi&apos;) - platform-agnostic</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/resourceType -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/resourceType">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/PlatformResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Type of platform resource: &apos;volume&apos;, &apos;network&apos;, &apos;ingress&apos;, &apos;service&apos;, &apos;nodePort&apos;, &apos;serviceType&apos;, &apos;launchType&apos;, &apos;composeVersion&apos;</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.khaos.uma.es/microwl/resourceValue -->

    <owl:DatatypeProperty rdf:about="http://www.khaos.uma.es/microwl/resourceValue">
        <rdfs:domain rdf:resource="http://www.khaos.uma.es/microwl/PlatformResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Value associated with a platform resource (e.g., port number, volume name, ARN)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.khaos.uma.es/microwl/AbstractConcept -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/AbstractConcept">
        <rdfs:comment>Marker for abstract concepts that platform-specific resources implement</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/CloudProvider -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/CloudProvider">
        <rdfs:comment xml:lang="en">Cloud provider (AWS, GCP, Azure, etc.)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/ComputeService -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/ComputeService">
        <rdfs:comment xml:lang="en">Managed compute service (EKS, GKE, AKS, ECS)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/ContainerSpecification -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/ContainerSpecification">
        <rdfs:subClassOf rdf:resource="http://www.khaos.uma.es/microwl/DeploymentConfiguration"/>
        <rdfs:comment xml:lang="en">Container configuration: image, ports, environment variables</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/DeploymentConfiguration -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/DeploymentConfiguration">
        <rdfs:comment xml:lang="en">Root class for all deployment configuration elements</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/DeploymentError -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/DeploymentError"/>
    


    <!-- http://www.khaos.uma.es/microwl/DeploymentPattern -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/DeploymentPattern">
        <rdfs:comment xml:lang="en">Reusable deployment pattern (sidecar, ambassador, etc.)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/DeploymentPlatform -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/DeploymentPlatform">
        <rdfs:comment xml:lang="en">A platform where applications can be deployed</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/DockerComposeConfig -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/DockerComposeConfig">
        <rdfs:subClassOf rdf:resource="http://www.khaos.uma.es/microwl/PlatformSpecificConfiguration"/>
        <rdfs:comment xml:lang="en">Docker Compose specific configuration</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/DockerNetwork -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/DockerNetwork">
        <rdfs:subClassOf rdf:resource="http://www.khaos.uma.es/microwl/PlatformResource"/>
        <rdfs:comment xml:lang="en">Docker network resource</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/DockerVolume -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/DockerVolume">
        <rdfs:subClassOf rdf:resource="http://www.khaos.uma.es/microwl/PlatformResource"/>
        <rdfs:comment xml:lang="en">Docker volume resource</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/ECSConfig -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/ECSConfig">
        <rdfs:subClassOf rdf:resource="http://www.khaos.uma.es/microwl/PlatformSpecificConfiguration"/>
        <rdfs:comment xml:lang="en">AWS ECS specific configuration</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/ECSService -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/ECSService">
        <rdfs:subClassOf rdf:resource="http://www.khaos.uma.es/microwl/PlatformResource"/>
        <rdfs:comment xml:lang="en">ECS Service resource</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/EnvironmentVariable -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/EnvironmentVariable">
        <rdfs:comment xml:lang="en">Environment variable key-value pair</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.khaos.uma.es/microwl/InconsistentDeployment -->

    <owl:Class rdf:about="http://www.khaos.uma.es/microwl/InconsistentDeployment">
        <rdfs:subClassOf rdf:resource="http://www.khaos.uma.es/microwl/DeploymentError"/>
