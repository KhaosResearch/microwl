        <microwl:hasResource rdf:resource="http://www.khaos.uma.es/microwl/PaymentProcessor_K8s_ServiceType"/>
        <microwl:platformConfigOf rdf:resource="http://www.khaos.uma.es/microwl/PaymentProcessor"/>
    </owl:NamedIndividual>
    


    <!-- http://www.khaos.uma.es/microwl/PaymentProcessor_K8s_ServiceType -->

    <owl:NamedIndividual rdf:about="http://www.khaos.uma.es/microwl/PaymentProcessor_K8s_ServiceType">
        <rdf:type rdf:resource="http://www.khaos.uma.es/microwl/PlatformResource"/>
        <microwl:resourceOf rdf:resource="http://www.khaos.uma.es/microwl/PaymentProcessor_K8sConfig"/>
        <microwl:resourceType>serviceType</microwl:resourceType>
        <microwl:resourceValue>ClusterIP</microwl:resourceValue>
    </owl:NamedIndividual>
    


    <!-- http://www.khaos.uma.es/microwl/PaymentProcessor_NetworkSpec -->

    <owl:NamedIndividual rdf:about="http://www.khaos.uma.es/microwl/PaymentProcessor_NetworkSpec">
        <rdf:type rdf:resource="http://www.khaos.uma.es/microwl/NetworkSpecification"/>
        <microwl:networkSpecOf rdf:resource="http://www.khaos.uma.es/microwl/PaymentProcessor"/>
        <microwl:hasExposedPort rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8080</microwl:hasExposedPort>
    </owl:NamedIndividual>
    


    <!-- http://www.khaos.uma.es/microwl/PaymentProcessor_StorageSpec -->

    <owl:NamedIndividual rdf:about="http://www.khaos.uma.es/microwl/PaymentProcessor_StorageSpec">
        <rdf:type rdf:resource="http://www.khaos.uma.es/microwl/StorageSpecification"/>
        <microwl:storageSpecOf rdf:resource="http://www.khaos.uma.es/microwl/PaymentProcessor"/>
        <microwl:hasAccessMode>ReadWriteOnce</microwl:hasAccessMode>
        <microwl:hasStorageSize>5Gi</microwl:hasStorageSize>
    </owl:NamedIndividual>
    


    <!-- http://www.khaos.uma.es/microwl/PaymentProcessor_WorkloadSpec -->

    <owl:NamedIndividual rdf:about="http://www.khaos.uma.es/microwl/PaymentProcessor_WorkloadSpec">
        <rdf:type rdf:resource="http://www.khaos.uma.es/microwl/WorkloadSpecification"/>
        <microwl:workloadSpecOf rdf:resource="http://www.khaos.uma.es/microwl/PaymentProcessor"/>
        <microwl:hasReplicas rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</microwl:hasReplicas>
    </owl:NamedIndividual>
    


    <!-- http://www.khaos.uma.es/microwl/StandardWebAppPattern -->

    <owl:NamedIndividual rdf:about="http://www.khaos.uma.es/microwl/StandardWebAppPattern">
        <rdf:type rdf:resource="http://www.khaos.uma.es/microwl/DeploymentPattern"/>
        <microwl:hasDescription xml:lang="en">Single container web app with HTTP exposure and persistent storage</microwl:hasDescription>
        <rdfs:label>Standard Web Application Pattern</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.khaos.uma.es/microwl/StranglerFigPattern -->

    <owl:NamedIndividual rdf:about="http://www.khaos.uma.es/microwl/StranglerFigPattern">
        <rdf:type rdf:resource="http://www.khaos.uma.es/microwl/MigrationPattern"/>
        <microwl:hasDescription xml:lang="en">Gradual replacement of monolithic functionality with microservices</microwl:hasDescription>
        <rdfs:label>Strangler Fig Pattern</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/DatabasePerServicePattern -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/DatabasePerServicePattern">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Pattern"/>
        <microwl:hasDescription xml:lang="en">Each microservice owns its database, ensuring loose coupling</microwl:hasDescription>
        <rdfs:label>Database per Service Pattern</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/SharedPersistenceAntiPattern -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/SharedPersistenceAntiPattern">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/AntiPattern"/>
        <microwl:hasDescription xml:lang="en">Multiple microservices sharing the same database, leading to tight coupling</microwl:hasDescription>
        <rdfs:label>Shared Persistence Anti-Pattern</rdfs:label>
    </owl:NamedIndividual>
    


