    <!-- http://www.khaos.uma.es/microwl/DataAggregator -->

    <owl:NamedIndividual rdf:about="http://www.khaos.uma.es/microwl/DataAggregator">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/Microservice"/>
        <microwl:deployedTo rdf:resource="http://www.khaos.uma.es/microwl/DockerComposePlatform"/>
        <microwl:deployedTo rdf:resource="http://www.khaos.uma.es/microwl/ECSPlatform"/>
        <microwl:deployedTo rdf:resource="http://www.khaos.uma.es/microwl/KubernetesPlatform"/>
        <microwl:hasContainerSpec rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_ContainerSpec"/>
        <microwl:hasNetworkSpec rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_NetworkSpec"/>
        <microwl:hasPlatformConfig rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_DockerConfig"/>
        <microwl:hasPlatformConfig rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_ECSConfig"/>
        <microwl:hasPlatformConfig rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_K8sConfig"/>
        <microwl:hasStorageSpec rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_StorageSpec"/>
        <microwl:hasWorkloadSpec rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_WorkloadSpec"/>
        <microwl:hasDescription xml:lang="en">Batch microservice that consumes Kafka messages, aggregates data, and writes to analytical storage</microwl:hasDescription>
        <rdfs:label>DataAggregator</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.khaos.uma.es/microwl/DataAggregator_ContainerSpec -->

    <owl:NamedIndividual rdf:about="http://www.khaos.uma.es/microwl/DataAggregator_ContainerSpec">
        <rdf:type rdf:resource="http://www.khaos.uma.es/microwl/ContainerSpecification"/>
        <microwl:containerSpecOf rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator"/>
        <microwl:hasEnvironmentVariable rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_EnvVar_BatchSize"/>
        <microwl:hasEnvironmentVariable rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_EnvVar_KafkaBootstrap"/>
        <microwl:hasEnvironmentVariable rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_EnvVar_TopicInput"/>
        <microwl:hasEnvironmentVariable rdf:resource="http://www.khaos.uma.es/microwl/DataAggregator_EnvVar_TopicOutput"/>
        <microwl:hasContainerImage>data-aggregator:1.0.0</microwl:hasContainerImage>
        <microwl:hasContainerPort rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9090</microwl:hasContainerPort>
    </owl:NamedIndividual>
    


