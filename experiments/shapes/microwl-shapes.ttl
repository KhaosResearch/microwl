@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mw:    <http://www.khaos.uma.es/microwl/> .
@prefix omsac: <http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/> .
@prefix ex:    <http://www.khaos.uma.es/microwl/shapes/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

ex: a owl:Ontology ;
  sh:declare [ sh:prefix "mw" ; sh:namespace "http://www.khaos.uma.es/microwl/"^^xsd:anyURI ] .

# SHACL counterpart of the SWRL rules of MicrOWL with the same (open-world) semantics,
# including the open-world S2.
# Generated by experiments/build_shapes.py. Every message starts with the identifier of the
# constraint (S3 covers S3a, S3b and S4, S8 covers S8a and S8b). Warnings have sh:severity sh:Warning.

ex:MicroserviceShape a sh:NodeShape ;
  sh:targetClass omsac:Microservice ;
  sh:severity sh:Violation ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S1: {?r} replicas share a ReadWriteOnce volume" ;
    sh:select """SELECT $this ?r WHERE {
      $this mw:hasWorkloadSpec/mw:hasReplicas ?r . FILTER(?r > 1)
      $this mw:hasStorageSpec ?st . ?st a mw:SharedStorageSpecification ;
        mw:hasAccessMode ?am . FILTER(str(?am) = "ReadWriteOnce") }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S2: target port {?t} differs from container port {?c}" ;
    sh:select """SELECT $this ?t ?c WHERE {
      $this mw:hasContainerSpec/mw:hasContainerPort ?c ;
            mw:hasNetworkSpec/mw:hasTargetPort ?t . FILTER(?c != ?t) }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S3: NodePort {?p} outside [30000, 32767]" ;
    sh:select """SELECT $this ?p WHERE {
      $this mw:hasPlatformConfig ?k . ?k a mw:KubernetesConfig ;
        mw:hasResource ?res . ?res a mw:NodePortResource ; mw:hasNodePortValue ?p .
      FILTER(?p < 30000 || ?p > 32767) }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S7: {?r} replicas bind host port {?h}" ;
    sh:select """SELECT $this ?r ?h WHERE {
      $this mw:hasWorkloadSpec/mw:hasReplicas ?r . FILTER(?r > 1)
      $this mw:hasNetworkSpec/mw:hasHostPort ?h . }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S8: host port {?h} is also published by another service of the Compose file" ;
    sh:select """SELECT $this ?h WHERE {
      $this mw:inDeployment ?u ; mw:hasPlatformConfig ?c1 ; mw:hasNetworkSpec/mw:hasHostPort ?h .
      ?c1 a mw:DockerComposeConfig .
      ?m2 mw:inDeployment ?u ; mw:hasPlatformConfig ?c2 ; mw:hasNetworkSpec/mw:hasHostPort ?h2 .
      ?c2 a mw:DockerComposeConfig . FILTER(?h2 = ?h && ?m2 != $this) }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S15: {?r} replicas share a ReadWriteOncePod volume" ;
    sh:select """SELECT $this ?r WHERE {
      $this mw:hasWorkloadSpec/mw:hasReplicas ?r . FILTER(?r > 1)
      $this mw:hasStorageSpec ?st . ?st a mw:SharedStorageSpecification ;
        mw:hasAccessMode ?am . FILTER(str(?am) = "ReadWriteOncePod") }""" ] .

ex:MicroserviceWarningShape a sh:NodeShape ;
  sh:targetClass omsac:Microservice ;
  sh:severity sh:Warning ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S5: ReadWriteOnce storage with {?r} replicas" ;
    sh:select """SELECT $this ?r WHERE {
      $this mw:hasWorkloadSpec/mw:hasReplicas ?r . FILTER(?r < 1)
      $this mw:hasStorageSpec/mw:hasAccessMode ?am . FILTER(str(?am) = "ReadWriteOnce") }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S11: {?r} replicas started from the mutable tag {?t}" ;
    sh:select """SELECT $this ?r ?t WHERE {
      $this mw:hasWorkloadSpec/mw:hasReplicas ?r . FILTER(?r > 1)
      $this mw:hasContainerSpec/mw:hasImageTag ?t . FILTER(str(?t) = "latest") }""" ] .

ex:EndpointShape a sh:NodeShape ;
  sh:targetClass mw:ServiceEndpoint ;
  sh:severity sh:Violation ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S8: NodePort {?p} is also opened by another endpoint of the deployment unit" ;
    sh:select """SELECT $this ?p WHERE {
      $this mw:inDeployment ?u ; mw:hasEndpointNodePort ?p .
      ?e2 a mw:ServiceEndpoint ; mw:inDeployment ?u ; mw:hasEndpointNodePort ?p2 .
      FILTER(?p2 = ?p && ?e2 != $this) }""" ] .
