@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mw:    <http://www.khaos.uma.es/microwl/> .
@prefix omsac: <http://www.semanticweb.org/ontologyOfMicroservicesArchitecture/> .
@prefix ex:    <http://www.khaos.uma.es/microwl/shapes/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

ex: a owl:Ontology ;
  sh:declare [ sh:prefix "mw" ; sh:namespace "http://www.khaos.uma.es/microwl/"^^xsd:anyURI ] .

# Closed-world variant of every MicrOWL constraint (S2c instead of S2, plus the
# constraints that need negation as failure: S9, S10, S12, S13, S14, S16).
# Generated by experiments/build_shapes.py. Every message starts with the identifier of the
# constraint (S3 covers S3a, S3b and S4, S8 covers S8a and S8b). Warnings have sh:severity sh:Warning.

ex:MicroserviceShape a sh:NodeShape ;
  sh:targetClass omsac:Microservice ;
  sh:severity sh:Violation ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S1: {?r} replicas share a ReadWriteOnce volume" ;
    sh:select """SELECT $this ?r WHERE {
      $this mw:hasWorkloadSpec/mw:hasReplicas ?r . FILTER(?r > 1)
      $this mw:hasStorageSpec ?st . ?st a mw:SharedStorageSpecification ;
        mw:hasAccessMode ?am . FILTER(str(?am) = "ReadWriteOnce") }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S2c: target port {?t} matches none of the container ports" ;
    sh:select """SELECT $this ?t WHERE {
      $this mw:hasNetworkSpec/mw:hasTargetPort ?t .
      FILTER EXISTS { $this mw:hasContainerSpec/mw:hasContainerPort ?any }
      FILTER NOT EXISTS { $this mw:hasContainerSpec/mw:hasContainerPort ?t2 . FILTER(?t2 = ?t) } }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S3: NodePort {?p} outside [30000, 32767]" ;
    sh:select """SELECT $this ?p WHERE {
      $this mw:hasPlatformConfig ?k . ?k a mw:KubernetesConfig ;
        mw:hasResource ?res . ?res a mw:NodePortResource ; mw:hasNodePortValue ?p .
      FILTER(?p < 30000 || ?p > 32767) }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S7: {?r} replicas bind host port {?h}" ;
    sh:select """SELECT $this ?r ?h WHERE {
      $this mw:hasWorkloadSpec/mw:hasReplicas ?r . FILTER(?r > 1)
      $this mw:hasNetworkSpec/mw:hasHostPort ?h . }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S8: host port {?h} is also published by another service of the Compose file" ;
    sh:select """SELECT $this ?h WHERE {
      $this mw:inDeployment ?u ; mw:hasPlatformConfig ?c1 ; mw:hasNetworkSpec/mw:hasHostPort ?h .
      ?c1 a mw:DockerComposeConfig .
      ?m2 mw:inDeployment ?u ; mw:hasPlatformConfig ?c2 ; mw:hasNetworkSpec/mw:hasHostPort ?h2 .
      ?c2 a mw:DockerComposeConfig . FILTER(?h2 = ?h && ?m2 != $this) }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S9: dependency on {?h} uses port {?p}, which the endpoint does not serve" ;
    sh:select """SELECT $this ?h ?p WHERE {
      $this mw:hasDependency ?d ; mw:inDeployment ?u . ?d mw:dependsOnHost ?h .
      ?e a mw:ServiceEndpoint ; mw:inDeployment ?u ; mw:hasEndpointName ?n . FILTER(str(?n) = str(?h))
      ?d mw:dependsOnPort ?p .
      FILTER EXISTS { ?e mw:hasEndpointPort ?any }
      FILTER NOT EXISTS { ?e mw:hasEndpointPort ?q . FILTER(?q = ?p) } }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S9: dependency on {?h} uses port name {?pn}, which the endpoint does not define" ;
    sh:select """SELECT $this ?h ?pn WHERE {
      $this mw:hasDependency ?d ; mw:inDeployment ?u . ?d mw:dependsOnHost ?h .
      ?e a mw:ServiceEndpoint ; mw:inDeployment ?u ; mw:hasEndpointName ?n . FILTER(str(?n) = str(?h))
      ?d mw:dependsOnPortName ?pn .
      FILTER NOT EXISTS { ?e mw:hasEndpointPortName ?qn . FILTER(str(?qn) = str(?pn)) } }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S10: dependency on {?h} names no endpoint of the deployment unit" ;
    sh:select """SELECT $this ?h WHERE {
      $this mw:hasDependency ?d ; mw:inDeployment ?u . ?d mw:dependsOnHost ?h .
      FILTER NOT EXISTS { ?u mw:isIncomplete true }
      FILTER NOT EXISTS { ?e a mw:ServiceEndpoint ; mw:inDeployment ?u ; mw:hasEndpointName ?n .
                          FILTER(str(?n) = str(?h)) } }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S14: probe port {?pp} is not a container port" ;
    sh:select """SELECT $this ?pp WHERE {
      $this mw:hasContainerSpec ?ct . ?ct mw:hasProbePort ?pp .
      FILTER EXISTS { ?ct mw:hasContainerPort ?any }
      FILTER NOT EXISTS { ?ct mw:hasContainerPort ?c . FILTER(?c = ?pp) } }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S15: {?r} replicas share a ReadWriteOncePod volume" ;
    sh:select """SELECT $this ?r WHERE {
      $this mw:hasWorkloadSpec/mw:hasReplicas ?r . FILTER(?r > 1)
      $this mw:hasStorageSpec ?st . ?st a mw:SharedStorageSpecification ;
        mw:hasAccessMode ?am . FILTER(str(?am) = "ReadWriteOncePod") }""" ] .

ex:MicroserviceWarningShape a sh:NodeShape ;
  sh:targetClass omsac:Microservice ;
  sh:severity sh:Warning ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S5: ReadWriteOnce storage with {?r} replicas" ;
    sh:select """SELECT $this ?r WHERE {
      $this mw:hasWorkloadSpec/mw:hasReplicas ?r . FILTER(?r < 1)
      $this mw:hasStorageSpec/mw:hasAccessMode ?am . FILTER(str(?am) = "ReadWriteOnce") }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S11: {?r} replicas started from the mutable tag {?t}" ;
    sh:select """SELECT $this ?r ?t WHERE {
      $this mw:hasWorkloadSpec/mw:hasReplicas ?r . FILTER(?r > 1)
      $this mw:hasContainerSpec/mw:hasImageTag ?t . FILTER(str(?t) = "latest") }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S16: no memory limit declared" ;
    sh:select """SELECT $this WHERE {
      FILTER NOT EXISTS { $this mw:hasContainerSpec/mw:hasMemoryLimit ?l } }""" ] .

ex:EndpointShape a sh:NodeShape ;
  sh:targetClass mw:ServiceEndpoint ;
  sh:severity sh:Violation ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S8: NodePort {?p} is also opened by another endpoint of the deployment unit" ;
    sh:select """SELECT $this ?p WHERE {
      $this mw:inDeployment ?u ; mw:hasEndpointNodePort ?p .
      ?e2 a mw:ServiceEndpoint ; mw:inDeployment ?u ; mw:hasEndpointNodePort ?p2 .
      FILTER(?p2 = ?p && ?e2 != $this) }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S12: the endpoint selects no microservice" ;
    sh:select """SELECT $this WHERE {
      $this mw:hasSelector ?s . FILTER(?s = true)
      FILTER NOT EXISTS { $this mw:inDeployment/mw:isIncomplete true }
      FILTER NOT EXISTS { $this mw:routesTo ?m } }""" ] .

ex:IngressShape a sh:NodeShape ;
  sh:targetClass mw:KubernetesIngress ;
  sh:severity sh:Violation ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S13: Ingress backend {?h} names no endpoint of the deployment unit" ;
    sh:select """SELECT $this ?h WHERE {
      $this mw:hasDependency ?d ; mw:inDeployment ?u . ?d mw:dependsOnHost ?h .
      FILTER NOT EXISTS { ?u mw:isIncomplete true }
      FILTER NOT EXISTS { ?e a mw:ServiceEndpoint ; mw:inDeployment ?u ; mw:hasEndpointName ?n .
                          FILTER(str(?n) = str(?h)) } }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S13: Ingress backend {?h} uses port {?p}, which the endpoint does not serve" ;
    sh:select """SELECT $this ?h ?p WHERE {
      $this mw:hasDependency ?d ; mw:inDeployment ?u . ?d mw:dependsOnHost ?h .
      ?e a mw:ServiceEndpoint ; mw:inDeployment ?u ; mw:hasEndpointName ?n . FILTER(str(?n) = str(?h))
      ?d mw:dependsOnPort ?p .
      FILTER EXISTS { ?e mw:hasEndpointPort ?any }
      FILTER NOT EXISTS { ?e mw:hasEndpointPort ?q . FILTER(?q = ?p) } }""" ] ;
  sh:sparql [ sh:prefixes ex: ; sh:message "S13: Ingress backend {?h} uses port name {?pn}, which the endpoint does not define" ;
    sh:select """SELECT $this ?h ?pn WHERE {
      $this mw:hasDependency ?d ; mw:inDeployment ?u . ?d mw:dependsOnHost ?h .
      ?e a mw:ServiceEndpoint ; mw:inDeployment ?u ; mw:hasEndpointName ?n . FILTER(str(?n) = str(?h))
      ?d mw:dependsOnPortName ?pn .
      FILTER NOT EXISTS { ?e mw:hasEndpointPortName ?qn . FILTER(str(?qn) = str(?pn)) } }""" ] .
